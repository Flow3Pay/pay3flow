apiVersion: v1
kind: Namespace
metadata:
  name: $PAY3FLOW_NAMESPACE
  labels:
    app.kubernetes.io/part-of: pay3flow
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: pay3flow-kaniko
  namespace: $PAY3FLOW_NAMESPACE
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: pay3flow-config
  namespace: $PAY3FLOW_NAMESPACE
data:
  SOURCE_REPOSITORY: "$PAY3FLOW_SOURCE_REPOSITORY"
  SOURCE_REVISION: "$PAY3FLOW_SOURCE_REVISION"
  IMAGE_REGISTRY: "$PAY3FLOW_IMAGE_REGISTRY"
  IMAGE_TAG: "$PAY3FLOW_IMAGE_TAG"
  DATABASE_MODE: "$PAY3FLOW_DATABASE_MODE"
  INGRESS_HOST: "$PAY3FLOW_INGRESS_HOST"
  config.toml: |
    log_filter = "info"
    http_addr = "0.0.0.0:8080"
    ap_origin = "$PAY3FLOW_AP_ORIGIN"
    ap_handle = "$PAY3FLOW_AP_HANDLE"
    ap_key_path = "/app/data/ap-key.pem"
    ap_require_signatures = $PAY3FLOW_AP_REQUIRE_SIGNATURES
    fmatch_inbox = "$PAY3FLOW_FMATCH_INBOX"
    fmatch_actor_id = "$PAY3FLOW_FMATCH_ACTOR_ID"
    fx_source = "$PAY3FLOW_FX_SOURCE"
    p2p_search_enabled = $PAY3FLOW_P2P_SEARCH_ENABLED
    near_intents_url = "https://1click.chaindefuser.com"
    near_intents_refresh_secs = 300
    symbiosis_url = "https://api.symbiosis.finance/crosschain"
    symbiosis_quote_address = "0x0000000000000000000000000000000000000001"
    symbiosis_slippage_bps = 300
    route_max_depth = 4
    route_source_fiats = ["AMD", "RUB"]
    route_p2p_assets = ["USDT", "USDC", "XRP"]
    route_intent_assets = ["USDT@tron", "USDT@avalanche-c", "USDT@solana", "USDC@solana", "XRP@xrpl"]
    route_withdrawals = []
    cow_api_urls = ["ethereum=https://api.cow.fi/mainnet"]
    cow_tokens = [
      "ethereum:USDT=0xdAC17F958D2ee523a2206206994597C13D831ec7",
      "ethereum:USDC=0xA0b86991c6218b36c1d19d4a2e9eb0ce3606eb48",
    ]
    cow_quote_address = "0x0000000000000000000000000000000000000001"
    near_intents_quote_recipient = "So11111111111111111111111111111111111111112"
    near_intents_quote_refund_to = "0x8ba1f109551bD432803012645Ac136ddd64DBA72"
    # Public dry-quote addresses selected by origin/destination network.
    # Executable swaps must use the user's wallet addresses.
    near_intents_quote_recipients = [
      "solana=So11111111111111111111111111111111111111112",
      "bitcoin=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh",
      "near=wrap.near",
      "ethereum=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
      "avalanche-c=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
      "arbitrum-one=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
      "bnb-smart-chain=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
      "optimism=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
      "polygon-pos=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
    ]
    near_intents_quote_refunds = [
      "solana=So11111111111111111111111111111111111111112",
      "bitcoin=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh",
      "near=wrap.near",
      "ethereum=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
      "avalanche-c=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
      "arbitrum-one=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
      "bnb-smart-chain=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
      "optimism=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
      "polygon-pos=0x8ba1f109551bD432803012645Ac136ddd64DBA72",
    ]
---
apiVersion: v1
kind: Secret
metadata:
  name: pay3flow-secrets
  namespace: $PAY3FLOW_NAMESPACE
type: Opaque
stringData:
  POSTGRES_PASSWORD: "$PAY3FLOW_POSTGRES_PASSWORD"
  DATABASE_URL: "$PAY3FLOW_DATABASE_URL"
  REDIS_URL: "$PAY3FLOW_REDIS_URL"
  JWT_SECRET: "$PAY3FLOW_JWT_SECRET"
  SECRETS_KEY: "$PAY3FLOW_SECRETS_KEY"
  ADMIN_TOKEN: "$PAY3FLOW_ADMIN_TOKEN"
  NEAR_INTENTS_JWT: "$PAY3FLOW_NEAR_INTENTS_JWT"
  BESTCHANGE_API_KEY: "$PAY3FLOW_BESTCHANGE_API_KEY"
  SYMBIOSIS_PARTNER_ID: "$PAY3FLOW_SYMBIOSIS_PARTNER_ID"
---
apiVersion: batch/v1
kind: Job
metadata:
  name: pay3flow-build-backend
  namespace: $PAY3FLOW_NAMESPACE
  labels:
    app.kubernetes.io/name: pay3flow
    app.kubernetes.io/component: image-build
spec:
  backoffLimit: 1
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: pay3flow
        app.kubernetes.io/component: image-build
    spec:
      restartPolicy: Never
      serviceAccountName: pay3flow-kaniko
      imagePullSecrets:
        - name: pay3flow-registry
      volumes:
        - name: source
          emptyDir: {}
        - name: registry
          secret:
            secretName: pay3flow-registry
            items:
              - key: .dockerconfigjson
                path: config.json
      initContainers:
        - name: checkout
          image: alpine/git:2.47.2
          envFrom:
            - configMapRef:
                name: pay3flow-config
          command: ["/bin/sh", "-c"]
          args:
            - >-
              git clone --no-checkout --depth 1 "$SOURCE_REPOSITORY" /workspace/source &&
              cd /workspace/source &&
              git fetch --depth 1 origin "$SOURCE_REVISION" &&
              git checkout --detach "$SOURCE_REVISION"
          volumeMounts:
            - name: source
              mountPath: /workspace/source
      containers:
        - name: kaniko
          image: gcr.io/kaniko-project/executor:v1.23.2
          envFrom:
            - configMapRef:
                name: pay3flow-config
          args:
            - --context=dir:///workspace/source
            - --dockerfile=/workspace/source/backend/Dockerfile
            - --destination=$(IMAGE_REGISTRY)/backend:$(IMAGE_TAG)
            - --cache=true
            - --cache-repo=$(IMAGE_REGISTRY)/cache
          volumeMounts:
            - name: source
              mountPath: /workspace/source
            - name: registry
              mountPath: /kaniko/.docker
---
apiVersion: batch/v1
kind: Job
metadata:
  name: pay3flow-build-frontend
  namespace: $PAY3FLOW_NAMESPACE
  labels:
    app.kubernetes.io/name: pay3flow
    app.kubernetes.io/component: image-build
spec:
  backoffLimit: 1
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: pay3flow
        app.kubernetes.io/component: image-build
    spec:
      restartPolicy: Never
      serviceAccountName: pay3flow-kaniko
      imagePullSecrets:
        - name: pay3flow-registry
      volumes:
        - name: source
          emptyDir: {}
        - name: registry
          secret:
            secretName: pay3flow-registry
            items:
              - key: .dockerconfigjson
                path: config.json
      initContainers:
        - name: checkout
          image: alpine/git:2.47.2
          envFrom:
            - configMapRef:
                name: pay3flow-config
          command: ["/bin/sh", "-c"]
          args:
            - >-
              git clone --no-checkout --depth 1 "$SOURCE_REPOSITORY" /workspace/source &&
              cd /workspace/source &&
              git fetch --depth 1 origin "$SOURCE_REVISION" &&
              git checkout --detach "$SOURCE_REVISION"
          volumeMounts:
            - name: source
              mountPath: /workspace/source
      containers:
        - name: kaniko
          image: gcr.io/kaniko-project/executor:v1.23.2
          envFrom:
            - configMapRef:
                name: pay3flow-config
          args:
            - --context=dir:///workspace/source/pay3low-svelte-frontend
            - --dockerfile=/workspace/source/pay3low-svelte-frontend/Dockerfile
            - --destination=$(IMAGE_REGISTRY)/frontend:$(IMAGE_TAG)
            - --cache=true
            - --cache-repo=$(IMAGE_REGISTRY)/cache
          volumeMounts:
            - name: source
              mountPath: /workspace/source
            - name: registry
              mountPath: /kaniko/.docker
---
apiVersion: v1
kind: Service
metadata:
  name: pay3flow-backend
  namespace: $PAY3FLOW_NAMESPACE
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: pay3flow-backend
  ports:
    - name: http
      port: 8080
      targetPort: http
      nodePort: 30081
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pay3flow-backend
  namespace: $PAY3FLOW_NAMESPACE
  labels:
    app.kubernetes.io/name: pay3flow-backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: pay3flow-backend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: pay3flow-backend
    spec:
      imagePullSecrets:
        - name: pay3flow-registry
      containers:
        - name: backend
          image: $PAY3FLOW_IMAGE_REGISTRY/backend:$PAY3FLOW_IMAGE_TAG
          imagePullPolicy: Always
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: pay3flow-secrets
                  key: DATABASE_URL
            - name: REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: pay3flow-secrets
                  key: REDIS_URL
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: pay3flow-secrets
                  key: JWT_SECRET
            - name: SECRETS_KEY
              valueFrom:
                secretKeyRef:
                  name: pay3flow-secrets
                  key: SECRETS_KEY
            - name: ADMIN_TOKEN
              valueFrom:
                secretKeyRef:
                  name: pay3flow-secrets
                  key: ADMIN_TOKEN
            - name: NEAR_INTENTS_JWT
              valueFrom:
                secretKeyRef:
                  name: pay3flow-secrets
                  key: NEAR_INTENTS_JWT
            - name: BESTCHANGE_API_KEY
              valueFrom:
                secretKeyRef:
                  name: pay3flow-secrets
                  key: BESTCHANGE_API_KEY
            - name: SYMBIOSIS_PARTNER_ID
              valueFrom:
                secretKeyRef:
                  name: pay3flow-secrets
                  key: SYMBIOSIS_PARTNER_ID
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
          volumeMounts:
            - name: backend-data
              mountPath: /app/data
            - name: backend-config
              mountPath: /app/config.toml
              subPath: config.toml
      volumes:
        - name: backend-data
          emptyDir: {}
        - name: backend-config
          configMap:
            name: pay3flow-config
---
apiVersion: v1
kind: Service
metadata:
  name: pay3flow-frontend
  namespace: $PAY3FLOW_NAMESPACE
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: pay3flow-frontend
  ports:
    - name: http
      port: 3000
      targetPort: http
      nodePort: 30080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pay3flow-frontend
  namespace: $PAY3FLOW_NAMESPACE
  labels:
    app.kubernetes.io/name: pay3flow-frontend
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: pay3flow-frontend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: pay3flow-frontend
    spec:
      imagePullSecrets:
        - name: pay3flow-registry
      containers:
        - name: frontend
          image: $PAY3FLOW_IMAGE_REGISTRY/frontend:$PAY3FLOW_IMAGE_TAG
          imagePullPolicy: Always
          ports:
            - name: http
              containerPort: 3000
          env:
            - name: HOST
              value: 0.0.0.0
            - name: PORT
              value: "3000"
            - name: PUBLIC_API_URL
              value: "$PAY3FLOW_PUBLIC_API_URL"
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: pay3flow
  namespace: $PAY3FLOW_NAMESPACE
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web,websecure
spec:
  ingressClassName: $PAY3FLOW_INGRESS_CLASS
  rules:
    - host: $PAY3FLOW_INGRESS_HOST
      http:
        paths:
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: pay3flow-backend
                port:
                  name: http
          - path: /ws
            pathType: Prefix
            backend:
              service:
                name: pay3flow-backend
                port:
                  name: http
          - path: /health
            pathType: Prefix
            backend:
              service:
                name: pay3flow-backend
                port:
                  name: http
          - path: /inbox
            pathType: Prefix
            backend:
              service:
                name: pay3flow-backend
                port:
                  name: http
          - path: /actor
            pathType: Prefix
            backend:
              service:
                name: pay3flow-backend
                port:
                  name: http
          - path: /.well-known
            pathType: Prefix
            backend:
              service:
                name: pay3flow-backend
                port:
                  name: http
          - path: /routing
            pathType: Prefix
            backend:
              service:
                name: pay3flow-backend
                port:
                  name: http
          - path: /
            pathType: Prefix
            backend:
              service:
                name: pay3flow-frontend
                port:
                  name: http
$PAY3FLOW_INGRESS_TLS_BLOCK
