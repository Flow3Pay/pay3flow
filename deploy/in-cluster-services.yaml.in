apiVersion: v1
kind: Service
metadata:
  name: pay3flow-postgres
  namespace: $PAY3FLOW_NAMESPACE
spec:
  selector:
    app.kubernetes.io/name: pay3flow-postgres
  ports:
    - name: postgres
      port: 5432
      targetPort: postgres
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: pay3flow-postgres
  namespace: $PAY3FLOW_NAMESPACE
spec:
  serviceName: pay3flow-postgres
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: pay3flow-postgres
  template:
    metadata:
      labels:
        app.kubernetes.io/name: pay3flow-postgres
    spec:
      containers:
        - name: postgres
          image: postgres:16-alpine
          ports:
            - name: postgres
              containerPort: 5432
          env:
            - name: POSTGRES_USER
              value: pay3flow
            - name: POSTGRES_DB
              value: pay3flow
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: pay3flow-secrets
                  key: POSTGRES_PASSWORD
          readinessProbe:
            exec:
              command: ["sh", "-c", "pg_isready -U pay3flow -d pay3flow"]
            initialDelaySeconds: 5
            periodSeconds: 5
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: [ReadWriteOnce]
        resources:
          requests:
            storage: 10Gi
        storageClassName: "$PAY3FLOW_STORAGE_CLASS"
---
apiVersion: v1
kind: Service
metadata:
  name: pay3flow-redis
  namespace: $PAY3FLOW_NAMESPACE
spec:
  selector:
    app.kubernetes.io/name: pay3flow-redis
  ports:
    - name: redis
      port: 6379
      targetPort: redis
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: pay3flow-redis
  namespace: $PAY3FLOW_NAMESPACE
spec:
  serviceName: pay3flow-redis
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: pay3flow-redis
  template:
    metadata:
      labels:
        app.kubernetes.io/name: pay3flow-redis
    spec:
      containers:
        - name: redis
          image: redis:7-alpine
          ports:
            - name: redis
              containerPort: 6379
          readinessProbe:
            exec:
              command: ["redis-cli", "ping"]
            initialDelaySeconds: 5
            periodSeconds: 5
          volumeMounts:
            - name: data
              mountPath: /data
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: [ReadWriteOnce]
        resources:
          requests:
            storage: 2Gi
        storageClassName: "$PAY3FLOW_STORAGE_CLASS"
