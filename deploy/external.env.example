# External PostgreSQL and Redis configuration.
PAY3FLOW_DATABASE_MODE=external
PAY3FLOW_DATABASE_URL=postgres://user:password@db.example.com:5432/pay3flow?sslmode=require
PAY3FLOW_REDIS_URL=rediss://:password@redis.example.com:6379
PAY3FLOW_NEAR_INTENTS_JWT=replace-with-a-NEAR-Intents-JWT
PAY3FLOW_BESTCHANGE_API_KEY=replace-with-a-BestChange-API-key
PAY3FLOW_SYMBIOSIS_PARTNER_ID=
