# Non-secret runtime settings live in ../config.toml.
# Set PAY3FLOW_CONFIG_FILE only when the TOML is mounted at another path.
# PAY3FLOW_CONFIG_FILE=/etc/pay3flow/config.toml

# Environment-only credentials and connection strings.
DATABASE_URL=postgres://pay3flow:change-me@localhost:5432/pay3flow
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-value
SECRETS_KEY=replace-with-application-key-material
ADMIN_TOKEN=replace-with-a-random-admin-token
# Optional authenticated NEAR Intents credential.
# NEAR_INTENTS_JWT=
# Optional Exnode merchant API credentials for live Exnode quotes.
# EXNODE_API_PUBLIC=
# EXNODE_API_PRIVATE=
# BestChange official API key from the referral-program dashboard.
# The referral account ID is not an API key.
# BESTCHANGE_API_KEY=
