RUST_LOG=info
HTTP_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://pay3flow:pay3flow@localhost:5432/pay3flow
JWT_SECRET=dev-secret-change-me

# Payments (phase 2)
# AES-GCM key material for provider credential encryption (32 bytes recommended)
SECRETS_KEY=
# Our service cut, percent of gross (PLAN #41)
SERVICE_FEE_PERCENT=0.7
# FX: mock (offline table) or http (live endpoint, PLAN #42)
FX_SOURCE=mock
FX_URL=https://api.frankfurter.app/latest
FX_CACHE_TTL_SECS=300
# Margin added on mid-market rate for cross-currency routes (PLAN #43)
FX_MARGIN_PERCENT=1.0

# Bank exchange-pair router (PLAN 2△)
# Bearer token protecting /api/admin/exchange-pairs (PLAN 46e)
ADMIN_TOKEN=dev-admin-token-change-me
# TTL of the /api/exchange-pairs in-memory cache, seconds (PLAN 46c)
PAIRS_CACHE_TTL_SECS=300

# ActivityPub / fmatch
AP_ORIGIN=http://localhost:8080
AP_HANDLE=pay3flow
AP_KEY_PATH=./data/ap-key.pem
AP_REQUIRE_SIGNATURES=false
FMATCH_INBOX=http://localhost:7277/inbox/actra
FMATCH_ACTOR_ID=http://localhost:7277/actor/actra