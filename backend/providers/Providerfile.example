# Copy this file to providers/<provider-slug>/Providerfile and replace the
# example values. The parent directory becomes the provider slug.

exchange_methods = ["exchanger"]

[sell]
source_url = "https://provider.example"
name = "Example Provider Sell"
currency = ["usd", "rub", "eur", "amd"]
banks = []

[buy]
source_url = "https://provider.example"
name = "Example Provider Buy"
currency = ["usd", "rub", "eur", "amd"]
banks = []

# Optional tests run before SQL generation. Uncomment and point to a real
# endpoint, or use source = path["tests.rs"] for standalone Rust tests.
# [test]
# source_url = "https://provider.example/health"
# expected_status = 200
# timeout_ms = 10000
# body_contains = "ok"
# json_equals = { "/status" = "ok" }

[guidance]
description = "Explain what the customer must verify and where the exchange is completed."
steps = [
  "Open the provider page and verify the currencies, amount, rate, fees, and limits.",
  "Follow the provider's payment or wallet instructions and verify the network before sending.",
]

[[guidance.links]]
label = "Open provider"
url = "https://provider.example"

# Delete this section if the provider is catalog-only. For a JSON API use
# [adapter.p2p] instead; complete examples are in binance/, bybit/, okx/,
# bitget/, and rapira/. Full format reference: Providerfile.md.
[workflow]
source_url = "https://provider.example"
get_exchange = "https://provider.example/exchange"
timeout_ms = 30000
supported_assets = ["USDT"]
fiat_probe_amount = 1000
asset_probe_amount = 100
default_min_fiat = 1
default_max_fiat = 1000000000
default_available_asset = 1000000000

[workflow.buy]
amount_mode = "fiat_probe"

[[workflow.buy.steps]]
action = "fill"
selector = 'input[name="fromAmount"]'
value = "{{amount}}"

[[workflow.buy.steps]]
action = "wait"
milliseconds = 500

[workflow.buy.fiat_amount]
selector = 'input[name="fromAmount"]'
property = "value"

[workflow.buy.asset_amount]
selector = 'input[name="toAmount"]'
property = "value"

[workflow.sell]
amount_mode = "asset_probe"

[[workflow.sell.steps]]
action = "fill"
selector = 'input[name="fromAmount"]'
value = "{{amount}}"

[[workflow.sell.steps]]
action = "wait"
milliseconds = 500

[workflow.sell.fiat_amount]
selector = 'input[name="toAmount"]'
property = "value"

[workflow.sell.asset_amount]
selector = 'input[name="fromAmount"]'
property = "value"
