exchange_methods = ["p2p", "exchanger"]

[guidance]
description = "Bitget P2P offers may change. Check the live advertisement and order details in Bitget."
steps = ["Match the advertiser and advertisement ID, then verify the amount, rate, limits, and payment method in Bitget."]
buy_steps = ["Pay only to the details shown in the active Bitget order. Confirm payment in Bitget after the transfer succeeds."]
sell_steps = ["Release crypto in Bitget only after the payment is visible in your own bank or payment account."]

[[guidance.links]]
label = "Bitget P2P"
url = "https://www.bitget.com/p2p-trade"

[sell]
source_url = "https://www.bitget.com"
name = "Bitget Sell"
currency = ["all"]
banks = []

[buy]
source_url = "https://www.bitget.com"
name = "Bitget Buy"
currency = ["all"]
banks = []

[adapter.p2p]
kind = "http_json"
endpoint = "https://www.bitget.com/v1/p2p/pub/adv/queryAdvList"
method = "POST"
headers = { Origin = "https://www.bitget.com", Referer = "https://www.bitget.com/p2p-trade" }
timeout_ms = 4000
supported_assets = ["USDT", "USDC", "BTC", "ETH"]

[adapter.p2p.buy]
request_json = '''{"side":1,"pageNo":1,"pageSize":"{{limit_number}}","coinCode":"{{asset}}","fiatCode":"{{fiat}}"}'''
items_pointer = "/data/dataList"
success_pointer = "/code"
success_value = "00000"
error_pointer = "/msg"

[adapter.p2p.sell]
request_json = '''{"side":2,"pageNo":1,"pageSize":"{{limit_number}}","coinCode":"{{asset}}","fiatCode":"{{fiat}}"}'''
items_pointer = "/data/dataList"
success_pointer = "/code"
success_value = "00000"
error_pointer = "/msg"

[adapter.p2p.offer]
ad_id_pointer = "/adNo"
fiat_pointer = "/fiatCode"
asset_pointer = "/coinCode"
price_pointer = "/price"
available_asset_pointer = "/editAmount"
min_fiat_pointer = "/minAmount"
max_fiat_pointer = "/maxAmount"
payment_methods_pointer = "/paymethodInfo"
payment_method_value_pointer = "/paymethodName"
pay_time_limit_pointer = "/payDuration"
advertiser_id_pointer = "/encryptUserId"
advertiser_nickname_pointer = "/nickName"
advertiser_user_type_pointer = "/certifiedMerchant"
verified_from_merchant = true
completed_orders_pointer = "/thirtyTunoverNum"
completion_rate_pointer = "/thirtyCompletionRate"
positive_rate_pointer = "/goodEvaluationRate"
source_url_template = "https://www.bitget.com/p2p-trade/{{side}}?fiatName={{fiat}}"
advertiser_profile_url_template = "https://www.bitget.com/p2p-trade/user/{{item:/encryptUserId}}"

[[adapter.p2p.offer.merchant_conditions]]
pointer = "/certifiedMerchant"
operator = "truthy"

[adapter.market]
kind = "http_json"
endpoint = "https://api.bitget.com/api/v2/spot/market/tickers"
method = "GET"
timeout_ms = 4000
items_pointer = "/data"
symbol_pointer = "/symbol"
bid_pointer = "/bidPr"
ask_pointer = "/askPr"
success_pointer = "/code"
success_value = "00000"
error_pointer = "/msg"
