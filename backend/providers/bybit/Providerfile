exchange_methods = ["p2p", "exchanger"]

[guidance]
description = "Bybit P2P results are public advertisements. Confirm that the same offer is still available in Bybit before ordering."
steps = ["Match the advertiser and advertisement ID, then verify the amount, price, limits, and payment method in Bybit."]
buy_steps = ["Follow the payment details in the active Bybit order and mark it paid only after sending the transfer."]
sell_steps = ["Check the payment in your own account before releasing crypto in Bybit."]

[[guidance.links]]
label = "Bybit P2P"
url = "https://www.bybit.com/fiat/trade/otc/"

[sell]
source_url = "https://www.bybit.com"
name = "Bybit Sell"
currency = ["all"]
banks = []

[buy]
source_url = "https://www.bybit.com"
name = "Bybit Buy"
currency = ["all"]
banks = []

[adapter.p2p]
kind = "http_json"
endpoint = "https://api2.bybit.com/fiat/otc/item/online"
method = "POST"
headers = { Origin = "https://www.bybit.com", Referer = "https://www.bybit.com/" }
timeout_ms = 4000
supported_assets = ["USDT", "USDC", "BTC", "ETH"]

[adapter.p2p.payment_method_aliases]
"T-Bank" = ["Tinkoff", "Tinkoff Bank"]
"Sberbank" = ["Sber"]
"Alfa-Bank Belarus" = ["Alfa Bank Belarus", "A-Bank"]
"Sber Bank Belarus" = ["BPS-Sberbank", "Sber Bank"]
"VTB Belarus" = ["VTB Bank Belarus", "Bank VTB Belarus"]
"Belagroprombank" = ["Agrobank", "Belagroprom Bank"]
"Bank Dabrabyt" = ["Dabrabyt"]
"Bank Reshenie" = ["Reshenie Bank"]
"Paritetbank" = ["Paritet Bank"]
"Priorbank" = ["PriorBank"]
"PrivatBank" = ["PrivatBank", "Privat Bank"]
"Monobank" = ["Monobank", "Mono Bank"]
"Oschadbank" = ["Oschadbank", "Oschad Bank"]
"PUMB" = ["PUMB", "First Ukrainian International Bank"]
"Raiffeisen Bank Aval" = ["Raiffeisen Bank", "Raiffeisenbank Aval"]
"Sense Bank" = ["Sense Bank", "Alfa-Bank Ukraine"]
"A-Bank" = ["A-Bank", "ABank"]
"UkrSibbank" = ["UkrSibbank", "UkrSib Bank"]
"Kaspi Bank" = ["Kaspi.kz", "Kaspi Gold", "Kaspi Bank Transfer"]
