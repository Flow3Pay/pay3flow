timeout_ms = 10000
max_results = "infinite"
asset_codes = { USDT = "128f589271cb4951b03e71e6323eb7be", USDC = "34309140878b4ae99f195ac091d49bab", BTC = "febc9973be4d4d53bb374476239eb219", ETH = "93c38b0169214f8689763ce9a63a73ff" }
supported_assets = ["USDT", "USDC", "BTC", "ETH"]

