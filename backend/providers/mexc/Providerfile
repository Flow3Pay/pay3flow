[guidance]
description = "MEXC P2P quotes can change. Match the advertisement in MEXC and follow the active order there."
steps = ["Check the advertiser, advertisement ID, current price, limits, and payment method inside MEXC before creating an order."]
buy_steps = ["Use only the payment details shown in the MEXC order. Mark the order paid only after the transfer succeeds and before the order expires."]
sell_steps = ["Verify that payment arrived in your own bank or payment account before releasing crypto in MEXC; a screenshot or message is not proof of receipt."]

