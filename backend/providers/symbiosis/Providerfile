# Symbiosis is a selectable cross-chain crypto quote provider. Its Rust
# implementation loads the supported token catalog and requests read-only
# quotes from the official API.

exchange_methods = ["exchanger"]

[code]
language = "rust"
source = path["symbiosis.rs"]

[sell]
source_url = "https://api.symbiosis.finance/crosschain/docs/"
name = "Symbiosis Sell"
currency = ["btc", "eth", "usdc", "usdt", "sol", "xrp", "bnb", "avax", "matic", "trx", "ton"]
banks = []

[buy]
source_url = "https://api.symbiosis.finance/crosschain/docs/"
name = "Symbiosis Buy"
currency = ["btc", "eth", "usdc", "usdt", "sol", "xrp", "bnb", "avax", "matic", "trx", "ton"]
banks = []

[fees]
kind = "quote_dependent"
description = "Symbiosis returns route and network fees with each live cross-chain quote; final execution costs depend on the selected route and network."
docs_url = "https://api.symbiosis.finance/crosschain/docs/"

[guidance]
description = "Cross-chain swap estimate. Pay3Flow does not connect your wallet or submit the transaction: open Symbiosis, verify the route, and approve the swap in your wallet."
steps = [
  "Open Symbiosis and connect the wallet that holds the source asset.",
  "Select the exact source and destination assets and networks shown in this route.",
  "Check the amount received, slippage, provider fee, network fee, quote expiry, and the destination wallet address.",
  "Submit the swap only after checking the network one more time, then wait for the destination transaction to complete.",
]

[[guidance.links]]
label = "Open Symbiosis WebApp"
url = "https://app.symbiosis.finance/"

[[guidance.links]]
label = "Symbiosis swap guide"
url = "https://docs.symbiosis.finance/main-concepts/symbiosis-cross-chain-swaps"

[[guidance.links]]
label = "Symbiosis fees and troubleshooting"
url = "https://docs.symbiosis.finance/user-guide-webapp/where-are-my-tokens-troubleshooting-guide"
