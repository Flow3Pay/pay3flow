# Catalog entry for the Nordstern DEX aggregator API.
exchange_methods = ["exchanger"]

[code]
language = "rust"
source = '''
pub use crate::providers::dex_aggregator::DexAggregatorRouteProvider as NordsternRouteProvider;
'''

[sell]
source_url = "https://docs.nordstern.finance/"
name = "Nordstern Sell"
currency = ["eth", "usdc", "usdt"]
banks = []

[buy]
source_url = "https://docs.nordstern.finance/"
name = "Nordstern Buy"
currency = ["eth", "usdc", "usdt"]
banks = []

[guidance]
description = "Catalog entry for the Nordstern DEX aggregator API. Token and network availability depends on the selected route and integrator."
steps = [
  "Check the integrator using Nordstern for supported tokens and networks.",
  "Review the final route, output amount, gas estimate, and slippage before signing.",
  "Confirm transactions only in a wallet or application you trust.",
]

[[guidance.links]]
label = "Nordstern documentation"
url = "https://docs.nordstern.finance/"
