[sell]
source_url = "https://exnode.ru/exchange"
name = "Exnode Sell"
currency = ["rub", "kzt", "uzs", "tjs"]
banks = []

[buy]
source_url = "https://exnode.ru/exchange"
name = "Exnode Buy"
currency = ["rub", "kzt", "uzs", "tjs"]
banks = []

# Exnode's public monitoring API does not require merchant API keys. It returns
# the exchange services currently listed for the requested route.
[adapter.p2p]
kind = "http_json"
market = "direct_exchange"
endpoint = "https://exnode.ru/-courses-/api/v2/rates"
method = "GET"
headers = { Accept = "application/json", User-Agent = "Mozilla/5.0" }
timeout_ms = 10000
asset_codes = { USDT = "USDTTRC" }
fiat_codes = { RUB = "SBPRUB", KZT = "CARDKZT", UZS = "CARDUZS", TJS = "CARDTJS" }
supported_fiats = ["RUB", "KZT", "UZS", "TJS"]
supported_assets = ["USDT"]
default_min_fiat = 1
default_max_fiat = 1000000000
default_available_asset = 1000000000

[adapter.p2p.buy]
query = { from = "{{fiat_code}}", to = "{{asset}}" }
items_pointer = "/items"

[adapter.p2p.sell]
query = { from = "{{asset}}", to = "{{fiat_code}}" }
items_pointer = "/items"

[adapter.p2p.buy.offer]
ad_id_pointer = "/exchanger_id"
fiat_amount_pointer = "/in"
asset_amount_pointer = "/out"
min_fiat_pointer = "/minamount"
max_fiat_pointer = "/maxamount"
payment_methods_pointer = "/from_currency"
advertiser_id_pointer = "/exchanger/id"
advertiser_nickname_pointer = "/exchanger/name"
merchant_default = true
verified_default = true
source_url_template = "{{item:/exchanger/url_site}}"
source_url_is_exact = true

[adapter.p2p.sell.offer]
ad_id_pointer = "/exchanger_id"
fiat_amount_pointer = "/out"
asset_amount_pointer = "/in"
min_fiat_pointer = "/minamount"
max_fiat_pointer = "/maxamount"
payment_methods_pointer = "/to_currency"
advertiser_id_pointer = "/exchanger/id"
advertiser_nickname_pointer = "/exchanger/name"
merchant_default = true
verified_default = true
source_url_template = "{{item:/exchanger/url_site}}"
source_url_is_exact = true
