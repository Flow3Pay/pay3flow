[sell]
source_url = "https://exnode.ru/exchange"
name = "Exnode Sell"
currency = ["rub", "kzt", "uzs", "tjs"]
banks = []

[buy]
source_url = "https://exnode.ru/exchange"
name = "Exnode Buy"
currency = ["rub", "kzt", "uzs", "tjs"]
banks = []

# Exnode's public P2P market endpoint does not require merchant API keys.
[adapter.p2p]
kind = "http_json"
endpoint = "https://api4.exnode.ru/api/proxy/4/market/offers/active"
method = "GET"
headers = { User-Agent = "Mozilla/5.0", Ua = "Mozilla/5.0" }
timeout_ms = 10000
asset_codes = { USDT = "USDTTRC" }
supported_fiats = ["RUB", "KZT", "UZS", "TJS"]
supported_assets = ["USDT"]
default_min_fiat = 1
default_max_fiat = 1000000000
default_available_asset = 1000000000

[adapter.p2p.buy]
query = { fiat = "{{fiat}}", crypto = "{{asset}}", banks = "", amount = "", type = "buy", page = "1", limit = "{{limit_number}}", sort = "rate_asc" }
items_pointer = "/info"

[adapter.p2p.sell]
query = { fiat = "{{fiat}}", crypto = "{{asset}}", banks = "", amount = "", type = "sell", page = "1", limit = "{{limit_number}}", sort = "rate_desc" }
items_pointer = "/info"

[adapter.p2p.offer]
ad_id_pointer = "/offer/internal_id"
asset_pointer = "/offer/crypto_token"
price_pointer = "/offer/course"
available_asset_pointer = "/offer/liquidity_crypto"
min_fiat_pointer = "/offer/limit_min"
max_fiat_pointer = "/offer/limit_max"
payment_methods_pointer = "/offer/paymentMethod"
payment_method_value_pointer = "/tech"
advertiser_id_pointer = "/user/client_id"
advertiser_nickname_pointer = "/user/nickname"
advertiser_user_type_pointer = "/user/merchant"
merchant_conditions = [{ pointer = "/user/merchant", operator = "truthy" }]
verified_conditions = [{ pointer = "/user/isVerified", operator = "truthy" }]
completed_orders_pointer = "/user/tradesCompleted"
completion_rate_pointer = "/user/tradesCompletedPercent"
source_url_is_exact = false
