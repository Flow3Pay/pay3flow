[guidance]
description = "OKX P2P listings are estimates until the order is created. Check the current offer and available payment methods in OKX."
steps = ["Match the advertiser nickname and advertisement ID, and check the order amount, rate, limits, and payment method in OKX."]
buy_steps = ["Place the buy order in OKX. Follow the payment details in that order and confirm payment there only after you have sent it."]
sell_steps = ["Place the sell order in OKX. Check receipt in your own payment account before releasing crypto in OKX."]

