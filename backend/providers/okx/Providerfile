[[adapter.p2p.offer.merchant_conditions]]
pointer = "/isInstitution"
operator = "truthy"

[[adapter.p2p.offer.merchant_conditions]]
pointer = "/merchantId"
operator = "non_empty"

[[adapter.p2p.offer.merchant_conditions]]
pointer = "/userType"
operator = "equals_ci"
value = "merchant"

