# CoW Swap is a selectable direct quote provider. Its chain-specific Rust
# implementation is compiled from this Providerfile into the backend binary.

exchange_methods = ["exchanger"]

[code]
language = "rust"
source = path["cow.rs"]

[sell]
source_url = "https://swap.cow.fi"
name = "CoW Swap Sell"
currency = ["eth", "weth", "usdc", "usdt", "dai", "cow"]
banks = []

[buy]
source_url = "https://swap.cow.fi"
name = "CoW Swap Buy"
currency = ["eth", "weth", "usdc", "usdt", "dai", "cow"]
banks = []

[fees]
kind = "quote_dependent"
description = "No universal fixed protocol percentage: market-order costs are included in the live quote; liquidity, gas, and optional partner fees can affect execution."
docs_url = "https://docs.cow.fi/cow-protocol"

[guidance]
description = "Eligible same-chain ERC20 swaps can be signed in Pay3Flow with your Ethereum wallet. Check the fresh quote and approval details in your wallet; other routes open in CoW Swap."

[[guidance.review_sources]]
kind = "trustscores"
url = "https://trustscores.org/companies/defi/swap.cow.fi"


[review_code]
language = "rust"
source = { path = "reviews.rs" }
