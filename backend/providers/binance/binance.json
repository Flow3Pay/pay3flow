{
  "name": "binance",
  "kind": "p2p",
  "enabled": false,
  "endpoint": "https://p2p.binance.com/bapi/c2c/v2/friendly/c2c/adv/search",
  "request": {
    "method": "POST",
    "headers": {
      "origin": "https://www.binance.com",
      "referer": "https://www.binance.com/"
    },
    "body": {
      "fiat": "{{fiat}}",
      "page": 1,
      "rows": {
        "$template": "fetch_limit",
        "$type": "number"
      },
      "tradeType": "{{side}}",
      "asset": "{{asset}}",
      "countries": [],
      "proMerchantAds": false,
      "shieldMerchantAds": false,
      "publisherType": null,
      "payTypes": [],
      "additionalKycVerifyFilter": 0
    },
    "side": {
      "buy": "BUY",
      "sell": "SELL"
    }
  },
  "response": {
    "success": {
      "path": "/code",
      "equals": "000000"
    },
    "items_path": "/data",
    "fields": {
      "ad_id": "/adv/advNo",
      "fiat": "/adv/fiatUnit",
      "asset": "/adv/asset",
      "price": "/adv/price",
      "available_asset": "/adv/tradableQuantity",
      "min_fiat": "/adv/minSingleTransAmount",
      "max_fiat": "/adv/maxSingleTransAmount",
      "payment_methods": "/adv/tradeMethods/*/tradeMethodName",
      "pay_time_limit_minutes": "/adv/payTimeLimit"
    },
    "advertiser": {
      "id": "/advertiser/userNo",
      "nickname": "/advertiser/nickName",
      "user_type": "/advertiser/userType",
      "completed_orders_30d": "/advertiser/monthOrderCount",
      "completion_rate_30d": {
        "path": "/advertiser/monthFinishRate",
        "transform": "ratio"
      },
      "positive_rate": {
        "path": "/advertiser/positiveRate",
        "transform": "ratio"
      }
    },
    "merchant_rules": [
      {
        "path": "/advertiser/merchantGroupMember",
        "op": "equals",
        "value": true
      },
      {
        "path": "/advertiser/userType",
        "op": "equals_ci",
        "value": "merchant"
      }
    ],
    "urls": {
      "source": "https://c2c.binance.com/en/adv?code={{ad_id}}",
      "advertiser_profile": "https://c2c.binance.com/en/advertiserDetail?advertiserNo={{advertiser_id}}"
    },
    "source_url_is_exact": true
  }
}
