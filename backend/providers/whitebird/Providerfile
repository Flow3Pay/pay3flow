exchange_methods = ["exchanger"]

[sell]
source_url = "https://whitebird.io/"
name = "Whitebird Sell"
currency = ["byn", "usd", "eur", "rub"]
banks = []

[buy]
source_url = "https://whitebird.io/"
name = "Whitebird Buy"
currency = ["byn", "usd", "eur", "rub"]
banks = []

[adapter.p2p]
kind = "http_json"
market = "direct_exchange"
endpoint = "https://api.whitebird.io/api/v3/exchange/client/quote"
method = "POST"
headers = { Origin = "https://whitebird.io", Referer = "https://whitebird.io/exchanger", Accept = "application/json" }
asset_codes = { USDT = "USDT_TRC", USDC = "USDC_ERC" }
supported_assets = ["TRX", "USDT", "ETH", "USDC", "BTC", "BNB", "GRAM", "SOL"]
fiat_probe_amount = 1000
asset_probe_amount = 1
default_min_fiat = 1
default_max_fiat = 1000000000
default_available_asset = 1000000000
timeout_ms = 5000

[adapter.p2p.buy]
amount_mode = "fiat_probe"
request_json = '''{"input":{"asset":"{{fiat}}","type":"FIAT_PROVIDER","amount":"{{amount}}"},"output":{"asset":"{{asset}}","type":"CRYPTO_TRANSFER"},"merchantId":"11111111-1111-1111-1111-111111111111"}'''

[adapter.p2p.buy.offer]
fiat_pointer = "/input/asset"
asset_pointer = "/output/asset"
fiat_amount_pointer = "/input/amount"
asset_amount_pointer = "/output/amount"
merchant_default = true
verified_default = true
source_url_template = "https://whitebird.io/exchanger"

[adapter.p2p.sell]
amount_mode = "asset_probe"
request_json = '''{"input":{"asset":"{{asset}}","type":"CRYPTO_TRANSFER","amount":"{{amount}}"},"output":{"asset":"{{fiat}}","type":"FIAT_PROVIDER"},"merchantId":"11111111-1111-1111-1111-111111111111"}'''

[adapter.p2p.sell.offer]
fiat_pointer = "/output/asset"
asset_pointer = "/input/asset"
fiat_amount_pointer = "/output/amount"
asset_amount_pointer = "/input/amount"
merchant_default = true
verified_default = true
source_url_template = "https://whitebird.io/exchanger"

[fees]
kind = "included_in_quote"
description = "The effective Pay3Flow rate uses Whitebird's final quoted input and output amounts, which already reflect the input and output fee amounts returned by the live quote API."
docs_url = "https://whitebird.io/exchanger"

[guidance]
description = "Open Whitebird and check the final exchange details before continuing."

